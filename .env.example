# Local development. Generate your own SECRET_KEY; never deploy this example value.
DEBUG=True
SECRET_KEY=dev-secret-key-change-me
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1

# Local Docker Compose: set a unique database password (URL-safe characters).
POSTGRES_PASSWORD=change-this-local-database-password

# Password reset links are printed to the console by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=taskflow@localhost

# HTTPS deployment defaults are enabled in config.settings.production.
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
